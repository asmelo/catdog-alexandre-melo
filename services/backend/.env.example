# ==========================================================================
# CatDog - Backend | Contrato de variaveis de ambiente
# Copie este arquivo para `.env` e preencha os valores reais.
# O `.env` NUNCA deve ser versionado; este `.env.example` SEMPRE deve.
# Toda leitura acontece exclusivamente em `src/config/env.ts`.
# ==========================================================================

# --- Aplicacao (consumidas nesta task) ---

# Ambiente de execucao: development | test | production
NODE_ENV=development

# Porta HTTP em que a API escuta
PORT=3333

# Conexao usada pela aplicacao — pooler do Supabase (porta 6543)
DATABASE_URL=postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Conexao direta (porta 5432) — obrigatoria para `prisma migrate`, que nao funciona via pooler
DIRECT_URL=postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Origens permitidas no CORS, separadas por virgula (wildcard proibido: usamos credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT / sessao (consumidas a partir da TASK-BACKEND-002/005) ---

# Segredo de assinatura do access token — minimo de 32 caracteres
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres

# Tempo de vida do access token (formato aceito pelo jsonwebtoken)
JWT_ACCESS_TTL=15m

# Emissor declarado no claim `iss`
JWT_ISSUER=catdog-api

# Audiencia declarada no claim `aud`
JWT_AUDIENCE=catdog-web

# Validade do refresh token, em dias
REFRESH_TOKEN_TTL_DAYS=7

# Validade do link de confirmacao de e-mail, em horas (RN-02)
EMAIL_CONFIRMATION_TTL_HOURS=24

# Custo (rounds) do bcrypt no hash de senha
BCRYPT_COST=12

# --- Frontend e cookies (consumidas a partir da TASK-BACKEND-003/005) ---

# URL publica do frontend — base dos links enviados por e-mail
APP_WEB_URL=http://localhost:5173

# Marca o cookie de refresh como Secure (true somente em HTTPS/producao)
COOKIE_SECURE=false

# Politica SameSite do cookie de refresh: lax | strict | none
COOKIE_SAME_SITE=lax

# Dominio do cookie de refresh (vazio = host da requisicao)
COOKIE_DOMAIN=

# --- SMTP / e-mail transacional (consumidas a partir da TASK-BACKEND-003) ---

# Servidor SMTP de saida
SMTP_HOST=smtp.gmail.com

# Porta SMTP (465 com TLS implicito, 587 com STARTTLS)
SMTP_PORT=465

# Usa TLS implicito na conexao SMTP
SMTP_SECURE=true

# Usuario SMTP (conta remetente)
SMTP_USER=conta@gmail.com

# Senha SMTP — usar App Password do Gmail, nunca a senha da conta
SMTP_PASSWORD=app-password-do-gmail

# Nome exibido como remetente
MAIL_FROM_NAME=CatDog

# Endereco exibido como remetente
MAIL_FROM_ADDRESS=noreply@catdog.com

# --- Rate limit (consumida a partir da TASK-BACKEND-006) ---

# Habilita o rate limit nas rotas sensiveis de autenticacao
RATE_LIMIT_ENABLED=true

# --- Seed administrativo (consumidas a partir da TASK-BACKEND-006) ---

# E-mail do administrador criado pelo seed
SEED_ADMIN_EMAIL=admin@catdog.com

# Senha do administrador criado pelo seed — minimo de 8 caracteres (RN-04)
SEED_ADMIN_PASSWORD=troque-esta-senha

# --- Armazenamento de objetos / Supabase Storage (consumidas a partir da TASK-BACKEND-004) ---

# URL base do projeto Supabase (a mesma do painel, sem barra no fim)
SUPABASE_URL=https://PROJETO.supabase.co

# Credencial de ESCRITA do armazenamento: vive somente no servidor e NUNCA e entregue ao navegador (RNF-04, CA-44)
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key-do-painel

# Balde dedicado as imagens de animal — leitura publica, escrita restrita a credencial de servico
SUPABASE_STORAGE_BUCKET=animal-images
